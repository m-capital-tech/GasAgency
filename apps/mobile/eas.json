{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_PLATFORM_API_URL": "https://munnauniteddistributions.com",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_PUSH_REGISTRATION_ENABLED": "true",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://munnauniteddistributions.com/privacy"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_PLATFORM_API_URL": "https://munnauniteddistributions.com",
        "EXPO_PUBLIC_DEMO_MODE": "false",
        "EXPO_PUBLIC_PUSH_REGISTRATION_ENABLED": "true",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://munnauniteddistributions.com/privacy"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
