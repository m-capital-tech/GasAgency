# Production tenant authentication API. Use the Metro host IP instead of localhost on a physical device.
EXPO_PUBLIC_PLATFORM_API_URL=http://localhost:8080

# The investor/demo engine is isolated and off by default. Enable it only for an explicit demo build.
EXPO_PUBLIC_DEMO_MODE=false
EXPO_PUBLIC_API_URL=http://localhost:4000

# Remote push is off until the authenticated platform registration endpoint and EAS project are configured.
EXPO_PUBLIC_PUSH_REGISTRATION_ENABLED=false

# Set this to the project UUID returned by `eas init`; required for EAS builds, remote push tokens, and OTA updates.
# EXPO_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
