# Production API / worker contract. Never place real secrets in this file.
APP_ENV=production
PORT=8080
DATABASE_URL=postgresql://runtime-user:replace-me@private-host:25060/platform?sslmode=verify-full
DATABASE_RUNTIME_ROLE=platform_runtime
DATABASE_SSL_MODE=verify-full
DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\nreplace-me\n-----END CERTIFICATE-----
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000
CORS_ORIGINS=https://provider-generated-admin-domain.example
PLATFORM_API_URL=http://127.0.0.1:8080
# Temporary review-only redirect. Set false when /control and /operations should open authenticated production dashboards directly.
INTERNAL_AUDIT_MODE=true
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=15000
SESSION_TOKEN_PEPPER=replace-with-at-least-32-random-characters
OTP_HASH_PEPPER=replace-with-a-distinct-at-least-32-character-secret
OTP_DELIVERY_KEY=replace-with-a-base64-encoded-32-byte-key
MFA_ENCRYPTION_KEY=replace-with-an-independent-base64-encoded-32-byte-key
PUSH_TOKEN_ENCRYPTION_KEY=replace-with-an-independent-base64-encoded-32-byte-key
MFA_TICKET_PEPPER=replace-with-an-independent-at-least-32-character-secret
MFA_ISSUER=Commercial LPG Platform
MFA_TICKET_TTL_SECONDS=600
MFA_MAX_ATTEMPTS=5
PRIVILEGED_SESSION_TTL_SECONDS=28800
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
SESSION_TTL_SECONDS=2592000
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=10
WORKER_STALE_LOCK_SECONDS=300
MESSAGE_PROVIDER=disabled
PUSH_PROVIDER=expo
EXPO_PUSH_REQUEST_TIMEOUT_MS=10000
PUSH_MAX_DELIVERY_ATTEMPTS=5
